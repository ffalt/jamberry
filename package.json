{
  "name": "jamberry",
  "version": "0.6.27",
  "author": "ffalt",
  "license": "MIT",
  "description": "a html5 jamserve web player",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:prod": "ng serve --configuration production",
    "build": "ng build",
    "check": "qlty check --all --no-formatters",
    "test": "ng test",
    "test:watch": "ng test --watch true",
    "test:coverage": "ng test --coverage",
    "lint": "ng lint && eslint .",
    "lint:fix": "ng lint --fix && eslint . --fix",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint:css": "stylelint \"**/*.css\"",
    "clean": "rimraf dist",
    "i18n:export": "ng extract-i18n --output-path src/locale",
    "release": "npx commit-and-tag-version -a",
    "update:angular": "ng update @angular/cli @angular/core",
    "build:changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 1",
    "build:releaselog": "node .github/scripts/extract-release.mjs",
    "build:prebuild": "npm run clean && npm run build:version",
    "build:version": "node ./build-pre.mjs",
    "build:stats": "ng build --named-chunks --configuration production --stats-json --output-hashing=none",
    "build:prod": "ng build --verbose --configuration production",
    "build:develop": "npm run build:prebuild && ng build",
    "build:deploy": "npm run build:prebuild && npm run build:prod",
    "analyze": "npm run build:stats && npx -y @angular-experts/hawkeye dist/stats.json"
  },
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "commit-and-tag-version": {
    "scripts": {
      "postbump": "node ./build-pre.mjs && git add ./src/environments/version.ts"
    }
  },
  "overrides": {
    "minimatch": "11.0.9",
    "glob": "14.0.6"
  },
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@types/d3": "^7.4.3",
    "core-js": "3.51.0",
    "d3": "7.9.2",
    "mousetrap": "1.6.5",
    "ngx-image-cropper": "9.1.7",
    "rxjs": "7.8.2",
    "soundmanager2": "2.97.20170602",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "@angular/localize": "22.3.0",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/mousetrap": "1.6.15",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "angular-eslint": "22.8.0",
    "baseline-browser-mapping": "2.11.39",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-angular": "9.4.0",
    "eslint": "10.15.0",
    "eslint-plugin-rxjs-x": "1.0.6",
    "eslint-plugin-unicorn": "80.0.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "rimraf": "6.1.4",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "stylelint-config-standard-scss": "18.0.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.4": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.5.6": true,
    "core-js@3.49.0": true
  }
}
